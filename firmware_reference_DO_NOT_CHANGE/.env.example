# Tuya T5AI Firmware Credentials
# Rename this file to .env and fill in your actual credentials

# Obtain these from: https://iot.tuya.com/
TUYA_PRODUCT_ID=your_product_id_here
TUYA_OPENSDK_UUID=your_uuid_here
TUYA_OPENSDK_AUTHKEY=your_authkey_here

# WiFi Configuration (Optional overrides)
# WIFI_SSID=YourWiFiSSID
# WIFI_PASSWORD=YourWiFiPassword

# Cloud Backend URL
# CLOUD_BACKEND_URL=http://your-backend-url:5000
