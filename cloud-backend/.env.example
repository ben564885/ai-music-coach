# =================================================================
# AI MUSIC COACH - BACKEND ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive credentials
# =================================================================

# =================================================================
# REQUIRED: Supabase (Database & Storage)
# =================================================================
# Sign up at https://supabase.com
# Get these from: Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# =================================================================
# REQUIRED: Google Gemini AI (AI Coaching)
# =================================================================
# Sign up at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# OR use legacy name (both work):
# GOOGLE_API_KEY=your-gemini-api-key-here

# =================================================================
# REQUIRED: Samplab (Audio-to-MIDI Conversion)
# =================================================================
# Sign up at https://samplab.com
SAMPLAB_EMAIL=your-email@example.com
SAMPLAB_PASSWORD=your-samplab-password

# =================================================================
# OPTIONAL: SoundSlice (OMR - Optical Music Recognition)
# =================================================================
# Sign up at https://www.soundslice.com
SOUNDSLICE_EMAIL=your-email@example.com
SOUNDSLICE_PASSWORD=your-soundslice-password
SOUNDSLICE_APP_ID=your-app-id
SOUNDSLICE_SECRET_KEY=your-secret-key

# =================================================================
# OPTIONAL: Roboflow (Alternative OMR)
# =================================================================
# Sign up at https://roboflow.com
ROBOFLOW_API_KEY=your-roboflow-api-key
ROBOFLOW_WORKSPACE=your-workspace-name
ROBOFLOW_WORKFLOW_ID=detect-and-classify
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_USE_INDIVIDUAL_MODELS=false

# =================================================================
# SERVER CONFIGURATION
# =================================================================
PORT=5001
FLASK_ENV=development
