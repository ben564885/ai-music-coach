# Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Roboflow (Optional for OMR)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=your_workspace_id
ROBOFLOW_WORKFLOW_ID=detect-and-classify

# SoundSlice (Optional for OMR)
SOUNDSLICE_EMAIL=your_email@example.com
SOUNDSLICE_PASSWORD=your_soundslice_password
SOUNDSLICE_APP_ID=your_app_id
SOUNDSLICE_SECRET_KEY=your_secret_key

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Audiveris (Optional)
# AUDIVERIS_CMD=audiveris
# AUDIVERIS_JAR=/path/to/audiveris.jar
